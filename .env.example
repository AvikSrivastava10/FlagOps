# FlagOps configuration. Copy this file to .env and fill it in.
# Required variables are listed as NAME=. Optional ones are commented out: remove the # to set one.
# An empty value counts as not set.

# --- Flagsmith ---

# Required. Flagsmith as your browser reaches it, for example http://localhost:8000.
# Dashboard links always use it, and so do FlagOps' own requests unless one of the next two rules applies.
FLAGSMITH_URL=

# Optional, http(s) URL. Where FlagOps' own requests to Flagsmith go, when that differs from FLAGSMITH_URL.
# FLAGSMITH_INTERNAL_URL=

# Optional, 0 or 1 (default 0). The FlagOps image sets 1; leave it to the image.
# With 1 and no FLAGSMITH_INTERNAL_URL, a localhost, 127.0.0.1 or [::1] host in FLAGSMITH_URL is rewritten
# to host.docker.internal for FlagOps' own requests, and the rewrite is logged at startup.
# FLAGOPS_IN_DOCKER=

# Required. Organisation API key of the Flagsmith organisation FlagOps manages: 20 to 128 characters, no spaces.
# On open-source Flagsmith this key is a full organisation admin key. It stays on the FlagOps server and is never sent to the browser.
FLAGSMITH_ORG_API_KEY=

# Optional, positive integer. Default: the organisation's only project.
# FLAGSMITH_PROJECT_ID=

# --- GitHub ---

# Optional. Fine-grained personal access token, 20 to 255 characters. Without it, scanning and Retire are disabled.
# GITHUB_TOKEN=

# Optional. Comma-separated owner/name repositories, at most 20, that FlagOps scans and may open cleanup pull requests against.
# GITHUB_REPOSITORIES=

# Optional, owner/name. Read only by pnpm demo:publish, which pushes examples/demo-shop to this repository.
# DEMO_REPO=

# --- Server ---

# Optional, 1 to 65535. Default 3000.
# FLAGOPS_PORT=

# Optional, IP address to listen on. Default 127.0.0.1, or 0.0.0.0 in the image.
# FLAGOPS_BIND=

# Optional. Comma-separated hostnames, without ports, that browsers use to reach FlagOps.
# Requests with any other Host header are refused. Default localhost,127.0.0.1,[::1].
# FLAGOPS_ALLOWED_HOSTS=

# Optional. URL of FlagOps used in pull request bodies and Flagsmith description lines. Default http://localhost:<port>.
# FLAGOPS_PUBLIC_URL=

# Optional, true or false (default false). Set true when FlagOps runs behind a reverse proxy that sets X-Forwarded headers.
# FLAGOPS_TRUST_PROXY=

# Optional, a writable directory for FlagOps' database. Default ./data, or /data in the image.
# FLAGOPS_DATA_DIR=

# Optional: error, warn, info or debug. Default info.
# LOG_LEVEL=

# --- Lifecycle policy ---

# Optional, 0 to 3650 days. Default: the project's stale_flags_limit_days in Flagsmith (30 unless changed).
# FLAGOPS_STALE_DAYS=

# Optional, 1 to 3650 days. Expected lifetime of release flags and of flags without a type. Default 40.
# FLAGOPS_LIFETIME_RELEASE_DAYS=

# Optional, 1 to 3650 days. Expected lifetime of experiment flags. Default 40.
# FLAGOPS_LIFETIME_EXPERIMENT_DAYS=

# --- Polling ---
# Each interval has a minimum, the fastest setting allowed. The demo video is recorded with the minimums.

# Optional, 15 to 3600 seconds; minimum 15. How often FlagOps syncs from Flagsmith. Default 60.
# FLAGOPS_SYNC_INTERVAL_SECONDS=

# Optional, 10 to 3600 seconds; minimum 10. How often FlagOps polls open cleanup pull requests. Default 30.
# FLAGOPS_PR_POLL_SECONDS=

# Optional, 300 to 86400 seconds; minimum 300. How often FlagOps refreshes its identity cache. Default 3600.
# FLAGOPS_IDENTITY_SYNC_SECONDS=

# --- Promote ---

# Optional, 1 to 50000. The most identities an impact preview evaluates. Default 5000.
# FLAGOPS_PREVIEW_MAX_IDENTITIES=

# --- Tests only: FlagOps itself never reads these ---

# Optional. Your Flagsmith email and password, for the end-to-end and live suites that sign in for real.
# Suites that need them are skipped with a message naming them when they are missing.
# E2E_FLAGSMITH_EMAIL=
# E2E_FLAGSMITH_PASSWORD=
