  {
    "name": "put_flag_as_read__responds_409",
    "source": "api/tests/integration/features/future/test_flag_endpoint.py::test_update_flag__put_flag_as_read__responds_409",
    "note": "The body is the flag exactly as GET returns it, which names the dependency's system segment.",
    "featureId": 300005,
    "body": {
      "environment_default": {
        "enabled": true,
        "value": { "type": "string", "value": "v1" },
        "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }]
      },
      "segment_overrides": [
        {
          "segment": { "id": 112 },
          "priority": 0,
          "enabled": false,
          "value": { "type": "string", "value": "v1" },
          "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }]
        },
        {
          "segment": { "id": 102 },
          "priority": 1,
          "enabled": true,
          "value": { "type": "string", "value": "v1" },
          "variants": [{ "id": 201, "weight": 50 }, { "id": 202, "weight": 30 }]
        }
      ]
    },
    "expected": {
      "rejection": {
        "status": 409,
        "code": "system_segment_modification",
        "message": "System segments and their overrides can't be changed directly. Change this one through flag dependency instead."
      }
    }
  },
