    "name": "put_segment_overrides__replaces_segment_overrides",
    "source": "api/tests/integration/features/future/test_flag_endpoint.py::test_update_flag__put_segment_overrides__replaces_segment_overrides",
    "note": "The omitted override is deleted; the kept one takes enabled from the environment default.",
    "featureId": 300003,
    "body": {
