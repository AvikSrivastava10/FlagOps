  {
    "name": "put_without_priorities__ranks_overrides_after_system_segment_override",
    "source": "api/tests/integration/features/future/test_flag_endpoint.py::test_update_flag__put_without_priorities__ranks_overrides_after_system_segment_override",
    "note": "The dependency override keeps priority 0 and follows the new default. The existing override keeps priority 1; the new one takes the second free slot.",
    "featureId": 300005,
    "body": {
      "environment_default": {
        "enabled": false,
        "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }]
      },
      "segment_overrides": [
        { "segment": { "id": 102 }, "enabled": true },
        { "segment": { "id": 101 }, "enabled": true }
      ]
    },
    "expected": {
      "flag": {
        "environmentDefault": {
          "enabled": false,
          "value": null,
          "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }]
        },
        "segmentOverrides": [
          { "segment": 112, "priority": 0, "enabled": false, "value": null, "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }] },
          { "segment": 102, "priority": 1, "enabled": true, "value": null, "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }] },
          { "segment": 101, "priority": 2, "enabled": true, "value": null, "variants": [{ "id": 201, "weight": 20 }, { "id": 202, "weight": 20 }] }
        ]
      },
      "createdSegmentIds": [101],
      "updatedSegmentIds": [102],
      "deletedSegmentIds": [],
      "estimatedSplitSegmentIds": [101]
    }
  },
