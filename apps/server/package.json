{
  "name": "@flagops/server",
  "version": "0.0.0",
  "private": true,
  "description": "FlagOps server: the JSON API, the background jobs and the built web app, in one process",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:generate": "openapi-typescript src/flagsmith/openapi/flagsmith-2.295.2.json --read-write-markers --output src/flagsmith/openapi/schema.d.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.15",
    "@babel/traverse": "7.29.15",
    "@babel/types": "7.29.15",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "11.0.0",
    "@flagops/shared": "workspace:*",
    "@flagsmith/nodejs": "9.5.0",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ignore": "7.0.17",
    "openapi-fetch": "0.17.0",
    "pino": "10.4.0",
    "tar": "7.5.24",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.28.0",
    "@types/better-sqlite3": "9.6.0",
    "openapi-typescript": "7.13.0"
  }
}
