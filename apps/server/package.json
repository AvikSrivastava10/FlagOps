{
  "name": "@flagops/server",
  "version": "0.0.0",
  "private": true,
  "description": "FlagOps server: the JSON API, the background jobs and the built web app, in one process",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:generate": "openapi-typescript src/flagsmith/openapi/flagsmith-2.295.2.json --output src/flagsmith/openapi/schema.d.ts"
  },
  "dependencies": {
    "@fastify/static": "11.0.0",
    "@flagops/shared": "workspace:*",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "openapi-typescript": "7.13.0"
  }
}
