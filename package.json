{
  "name": "flagops",
  "version": "0.0.0",
  "private": true,
  "description": "Lifecycle management for the feature flags of a self-hosted Flagsmith",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --conditions=development --env-file-if-exists=.env apps/server/src/main.ts",
    "dev:web": "pnpm --filter @flagops/web run dev",
    "build": "pnpm -r run build && node scripts/copy-web-dist.mjs",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts --project live",
    "test:live-session": "vitest run --config vitest.live.config.ts --project live-session",
    "test:live-github": "vitest run --config vitest.live.config.ts --project live-github",
    "seed": "tsx --conditions=development --env-file-if-exists=.env apps/server/src/cli/seed.ts",
    "demo:publish": "tsx --conditions=development --env-file-if-exists=.env apps/server/src/cli/demo-publish.ts",
    "openapi:generate": "pnpm --filter @flagops/server run openapi:generate",
    "openapi:check": "tsx --env-file-if-exists=.env apps/server/scripts/openapi-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6"
      }
    }
  }
}
